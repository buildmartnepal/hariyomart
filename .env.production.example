# Hariyo Mart Nepal v8.6.2 production environment template
# Copy values into Cloudflare Dashboard / Workers Builds. Never commit real secrets.

APP_ENV=production
DATA_PLATFORM=cloudflare-native
NEXT_PUBLIC_SITE_URL=https://hariyo-mart-nepal.nishrutesh.workers.dev
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DEMO_MODE=true
PRODUCTION_TEST_MODE=true
TURNSTILE_ENFORCEMENT_MODE=web

# Dashboard-managed public value (not committed in wrangler.jsonc)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_REAL_TURNSTILE_SITE_KEY

# Encrypted Cloudflare secrets
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_STRONG_RANDOM_SECRET
ADMIN_BOOTSTRAP_KEY=GENERATE_A_ONE_TIME_RANDOM_BOOTSTRAP_KEY
TURNSTILE_SECRET_KEY=YOUR_REAL_TURNSTILE_SECRET_KEY
