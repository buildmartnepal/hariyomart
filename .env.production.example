# HARIYO MART NEPAL — CLOUDFLARE PRODUCTION TEMPLATE
# Store secrets in Cloudflare Worker secrets / GitHub Actions secrets. Never commit real values.

# Cloudflare account and provisioned resource identifiers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# Web/mobile public URLs
NEXT_PUBLIC_SITE_URL=https://hariyo-mart-nepal.YOUR_SUBDOMAIN.workers.dev
NEXT_PUBLIC_API_URL=/api
EXPO_PUBLIC_API_URL=https://hariyo-mart-nepal.YOUR_SUBDOMAIN.workers.dev/api
EXPO_PUBLIC_WEB_URL=https://hariyo-mart-nepal.YOUR_SUBDOMAIN.workers.dev

# Set these with `wrangler secret put` on the hariyo-mart-nepal Worker
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_32_CHARACTER_SECRET
ADMIN_BOOTSTRAP_KEY=GENERATE_A_THIRD_RANDOM_SECRET

# Optional payment credentials. Keep online providers disabled until merchant onboarding,
# signed callback verification, reconciliation and refund flows are certified.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
