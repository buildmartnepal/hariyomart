# HARIYO MART NEPAL v8 — CLOUDFLARE-NATIVE PRODUCTION TEMPLATE
# Do not commit real secrets. Keep Worker secrets in Cloudflare via Wrangler/Dashboard.

# Cloudflare provisioning / CI only
# CI-only Cloudflare credentials should be injected by the CI secret store, not committed here.

# Public application URLs
NEXT_PUBLIC_SITE_URL=https://hariyomart.nishrutesh.workers.dev
NEXT_PUBLIC_API_URL=/api
EXPO_PUBLIC_API_URL=https://hariyomart.nishrutesh.workers.dev/api
EXPO_PUBLIC_WEB_URL=https://hariyomart.nishrutesh.workers.dev

# Cloudflare Turnstile site key is public. Configure the secret separately with Wrangler.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_ENFORCEMENT_MODE=web

# Worker-only secrets: set with `wrangler secret put <NAME>`
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_32_CHARACTER_SECRET
ADMIN_BOOTSTRAP_KEY=GENERATE_A_THIRD_RANDOM_SECRET
TURNSTILE_SECRET_KEY=

# Optional payment credentials. Keep providers disabled until merchant onboarding,
# signed callback verification, reconciliation and refund flows are certified.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
