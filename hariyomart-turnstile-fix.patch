+  fail(`${webPath} TURNSTILE_ENFORCEMENT_MODE must be "web" or "off"`);
@@
 const siteKey = String(vars.NEXT_PUBLIC_TURNSTILE_SITE_KEY || '');
-if (!siteKey || /REPLACE_WITH|PLACEHOLDER/i.test(siteKey)) {
-  const message = 'NEXT_PUBLIC_TURNSTILE_SITE_KEY is still a placeholder. Replace it before production deploy.';
-  console.warn(`WARNING: ${message} Deployment can proceed; rate limiting remains active.`);
+const turnstilePlaceholder = !siteKey || /REPLACE_WITH|PLACEHOLDER/i.test(siteKey);
+
+if (vars.TURNSTILE_ENFORCEMENT_MODE === 'web' && turnstilePlaceholder) {
+  fail(
+    `${webPath} cannot enable web Turnstile while NEXT_PUBLIC_TURNSTILE_SITE_KEY is missing or still a placeholder`,
+  );
+}
+
+if (vars.TURNSTILE_ENFORCEMENT_MODE === 'off') {
+  console.warn(
+    'WARNING: Turnstile is temporarily disabled. Authentication API rate limiting remains active. Configure a real site/secret key and switch TURNSTILE_ENFORCEMENT_MODE to web for production protection.',
+  );
 }

 console.log('Cloudflare v8.3.3 standalone production configuration PASS');

