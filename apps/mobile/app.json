{
  "expo": {
    "name": "Hariyo Mart Nepal",
    "slug": "hariyo-mart-nepal",
    "scheme": "hariyo",
    "version": "9.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A3024"
    },
    "ios": {
      "bundleIdentifier": "com.hariyomart.nepal",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hariyo Mart Nepal uses your location to show nearby farmers, pickup points and delivery options."
      }
    },
    "android": {
      "package": "com.hariyomart.nepal",
      "adaptiveIcon": {
        "backgroundColor": "#0A3024"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hariyo Mart Nepal to use your location to match nearby farmers and delivery options."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
