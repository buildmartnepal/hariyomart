{
  "name": "@hariyo/web",
  "version": "8.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.generated.d.ts",
    "cf:types:check": "wrangler types --env-interface CloudflareEnv cloudflare-env.generated.d.ts --check",
    "cf:db:local": "wrangler d1 migrations apply HARIYO_DB --local && wrangler d1 execute HARIYO_DB --local --file=seed/cloudflare.sql",
    "cf:db:remote": "wrangler d1 migrations apply HARIYO_DB --remote",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx scripts/seed.ts",
    "env:check": "tsx scripts/check-env.ts",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "cf:seed:remote": "wrangler d1 execute HARIYO_DB --remote --file=seed/cloudflare.sql",
    "cf:demo:local": "wrangler d1 execute HARIYO_DB --local --file=seed/demo-accounts.sql",
    "cf:demo:remote": "wrangler d1 execute HARIYO_DB --remote --file=seed/demo-accounts.sql",
    "cf:demo:remove:local": "wrangler d1 execute HARIYO_DB --local --file=seed/remove-demo-accounts.sql",
    "cf:demo:remove:remote": "wrangler d1 execute HARIYO_DB --remote --file=seed/remove-demo-accounts.sql",
    "cf:deploy:built": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.3",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
