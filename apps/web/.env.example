# Browser/build-time values only. Never place Worker secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Show removable demo account picker on /login. Keep false for real production.
NEXT_PUBLIC_DEMO_MODE=false
