# Hariyo Mart Nepal v8.2 — Cloudflare-native environment reference
# Production URL: https://hariyomart.nishrutesh.workers.dev
# Do not commit real secrets. Cloudflare production secrets should be set with Wrangler.

# Browser-safe values are sourced from apps/web/wrangler.jsonc in production.
NEXT_PUBLIC_SITE_URL=https://hariyomart.nishrutesh.workers.dev
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY

# Expo / mobile public endpoints
EXPO_PUBLIC_API_URL=https://hariyomart.nishrutesh.workers.dev/api
EXPO_PUBLIC_WEB_URL=https://hariyomart.nishrutesh.workers.dev

# Required Worker secrets — set with `wrangler secret put`, never as Wrangler vars.
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET

# One-time bootstrap only. Set before creating the first admin, then rotate/delete it.
ADMIN_BOOTSTRAP_KEY=OPTIONAL_ONE_TIME_BOOTSTRAP_SECRET

# Optional payment credentials. Leave unset until merchant integrations are production-ready.
ESEWA_MERCHANT_CODE=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=

# Cloudflare is the production data platform. MongoDB/Redis/Cloudinary are not required
# by the v8.2 Cloudflare-native runtime.

# Show removable demo account picker on /login. Keep false for real production.
NEXT_PUBLIC_DEMO_MODE=false
