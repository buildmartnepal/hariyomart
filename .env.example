# =========================================================
# HARIYO MART NEPAL — PRODUCTION ENVIRONMENT TEMPLATE
# Website: https://hariyomart.vercel.app
# Copy values into Vercel / EAS. Do NOT commit real secrets.
# =========================================================

# WEB — public/browser-safe
NEXT_PUBLIC_API_URL=https://hariyomart.vercel.app/api
NEXT_PUBLIC_SITE_URL=https://hariyomart.vercel.app

# MOBILE APP — configure in Expo/EAS production environment
EXPO_PUBLIC_API_URL=https://hariyomart.vercel.app/api
EXPO_PUBLIC_WEB_URL=https://hariyomart.vercel.app

# DATABASE — server only
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/hariyo_mart?retryWrites=true&w=majority

# REDIS — choose ONE method. REDIS_URL matches your original template.
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AUTH — generate with: npm --workspace apps/web run secrets:generate
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_PRODUCTION_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_PRODUCTION_SECRET
ADMIN_BOOTSTRAP_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_ADMIN_BOOTSTRAP_SECRET
CORS_ORIGIN=https://hariyomart.vercel.app

# PAYMENTS — server only. Leave blank until approved live merchant credentials exist.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=

# CLOUDINARY — uploads are signed by the server. API secret must NEVER be public.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Legacy standalone Express API only. Vercel Next.js Route Handlers do not use PORT.
PORT=4000
NODE_ENV=production
