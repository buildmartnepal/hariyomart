{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hariyo-mart-services",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "HARIYO_DB",
      "database_name": "hariyo-mart-production-apac",
      "database_id": "4be4c98b-6637-4e18-a990-a789222925d4",
      "migrations_dir": "../../../apps/web/migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "HARIYO_EVENTS", "queue": "hariyo-mart-events" }],
    "consumers": [
      {
        "queue": "hariyo-mart-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "hariyo-mart-events-dlq",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHECKOUT_COORDINATOR", "class_name": "CheckoutCoordinator" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CheckoutCoordinator", "RateLimiter"],
    },
  ],
}
